  "cards": [
    {
      "dot": "cyan",
      "title": "三条设计原则",
      "items": [
        "文件是账本（唯一权威），会话只是加速器",
        "产物是契约，执行层可插拔",
        "多样性来自取证方法，红队上下文互不可见"
      ]
    },
    {
      "dot": "emerald",
      "title": "收敛判定可计算",
      "items": [
        "账本五指标：R_t / E_t / C_t / S_t / K_t",
        "R_t 归零只代表无新分歧，不等于收敛",
        "E_t 归零且 R_t 仍大于零，两轮即僵局升级"
      ]
    },
    {
      "dot": "violet",
      "title": "收尾三种结局",
      "items": [
        "收敛：写 REVIEW- 文档，处置清单逐条回读",
        "缺证：只报缺证，不批量改",
        "未收敛：如实说明谁有分歧，不假装结束"
      ]
    },
    {
      "dot": "rose",
      "title": "最容易死的四件事",
      "items": [
        "忘记把上下文共享关掉，红队全体附和",
        "执行层不关原生并发，撞上限",
        "裁决对称下发，必然假收敛",
        "只信编辑回执，处置清单没落地"
      ]
    }
  ]
